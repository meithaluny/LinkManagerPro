@model LinkManagerPro.Models.Link

@{
    ViewData["Title"] = @Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title</title>

    <!-- Open Graph Meta Tags (للفيسبوك والواتس) -->
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:description" content="@Model.Description" />
    <meta property="og:image" content="@Model.ImageUrl" />
    <meta property="og:url" content="@Url.Action("Index", "Redirect", new { slug = Model.Slug }, "https")" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.Title" />
    <meta name="twitter:description" content="@Model.Description" />
    <meta name="twitter:image" content="@Model.ImageUrl" />

    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet"> *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100% );
        }

        .redirect-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            padding: 30px;
            max-width: 500px;
            text-align: center;
        }

            .redirect-card img {
                max-width: 100%;
                border-radius: 10px;
                margin-bottom: 20px;
            }

        .spinner {
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="redirect-card">
        <img src="@Model.ImageUrl" alt="@Model.Title" />
        <h2>@Model.Title</h2>
        <p class="text-muted">@Model.Description</p>

        <div class="spinner">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">جاري التحميل...</span>
            </div>
        </div>

        <p class="text-secondary">جاري إعادة التوجيه...</p>
        <p class="small">إذا لم يتم التوجيه، <a href="@Model.RedirectUrl">اضغط هنا</a></p>
    </div>

    <script>
        // إعادة التوجيه التلقائي بعد ثانية واحدة 
        // setTimeout(() => {
        //     window.location.href = "@Model.RedirectUrl";
        // }, 10);
    </script>
</body>
</html>
