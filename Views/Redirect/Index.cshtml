@model LinkManagerPro.Models.Link

@{
    ViewData["Title"] = @Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title</title>

    <!-- Open Graph Meta Tags (للفيسبوك والواتس) -->
    <meta property="og:title" content="@Model.Title" />
    <meta property="og:description" content="@Model.Description" />
    <meta property="og:image" content="@Model.ImageUrl" />
    <meta property="og:url" content="@Url.Action("Index", "Redirect", new { slug = Model.Slug }, "https")" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Model.Title" />
    <meta name="twitter:description" content="@Model.Description" />
    <meta name="twitter:image" content="@Model.ImageUrl" />

    @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet"> *@
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    <link href="~/lib/bootstrap-5.3.8-dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <style>
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100% );
        }

        .redirect-card {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            padding: 30px;
            max-width: 500px;
            text-align: center;
        }

            .redirect-card img {
                max-width: 100%;
                border-radius: 10px;
                margin-bottom: 20px;
            }

        .spinner {
            margin: 20px 0;
        }

        .countdown {
            width: 90px;
            height: 90px;
            margin: 20px auto;
            border-radius: 50%;
            background: #0d6efd;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            font-weight: bold;
        }

        .description {
            direction: rtl;
            unicode-bidi: plaintext; /* أو embed إذا لم يدعم المتصفح plaintext */
            text-align: right;
            white-space: pre-line;
            line-height: 1.8;
        }
    </style>
</head>
<body>
    <div class="redirect-card">
        <img src="@Model.ImageUrl" alt="@Model.Title" />

        <h2>@Model.Title</h2>

        <p class="text-muted description">@Model.Description</p>

        @if (!string.IsNullOrWhiteSpace(Model.CouponCode))
        {
            <div class="mt-3 mb-3" dir="ltr">

                <div class="input-group">
                    <input id="couponCode"
                           class="form-control text-center fw-bold"
                           value="@Model.CouponCode"
                           readonly />

                    <button id="copyBtn"
                            class="btn btn-primary"
                            onclick="copyCode()">
                        📋 انسخ الكود
                    </button>
                </div>

                <small id="copyMessage" class="text-success"></small>

            </div>
        }
        <p class="text-secondary">
            سيتم تحويلك خلال
           
            ثوانٍ...
        </p>
        <div class="countdown">
            <span id="countNumber">15</span>
        </div>

        

        <p class="small">
            إذا لم يتم التوجيه،
            <a href="@Model.RedirectUrl">
                اضغط هنا
            </a>
        </p>
    </div>

    <script>

        let seconds = 15;

        const countNumber = document.getElementById("countNumber");
        // const countText = document.getElementById("countText");

        const timer = setInterval(() => {

            seconds--;

            countNumber.innerText = seconds;
            // countText.innerText = seconds;

            if (seconds <= 0) {

                clearInterval(timer);

                window.location.href = "@Model.RedirectUrl";
                 //window.location.replace("@Model.RedirectUrl");

            }

        }, 1500);


        function copyCode() {

            const code = document.getElementById("couponCode").value;

            navigator.clipboard.writeText(code);

            document.getElementById("copyMessage").innerText = "✅ تم نسخ الكود";

        }

    </script>
    @* <script>
        // إعادة التوجيه التلقائي بعد ثانية واحدة 
        setTimeout(() => {
            window.location.href = "@Model.RedirectUrl";
        }, 10);
    </script> *@
</body>
</html>
