@{
    ViewData["Title"] = "الصفحة الرئيسية";
    Layout = "_Layout";
}

<div class="text-center py-5">
    <h1 class="display-4">مرحباً بك في Link Manager Pro</h1>
    <p class="lead">أداة احترافية لإدارة روابط الصور وإعادة التوجيه</p>
    <p class="lead">
        <a class="btn btn-primary btn-lg" asp-controller="Dashboard" asp-action="Index">ابدأ الآن</a>
    </p>


</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">إدارة الروابط</h5>
                <p class="card-text">أنشئ وعدّل وحذف روابطك بسهولة</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">تتبع النقرات</h5>
                <p class="card-text">راقب عدد النقرات على كل رابط</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">إحصائيات مفصلة</h5>
                <p class="card-text">احصل على تقارير شاملة</p>
            </div>
        </div>
    </div>
</div>
