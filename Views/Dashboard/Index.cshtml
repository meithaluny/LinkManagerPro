@model IEnumerable<LinkManagerPro.Models.Link>

@{
    ViewData["Title"] = "لوحة التحكم";
}

<div class="container mt-5">
    <h1>إدارة الروابط</h1>

    <a class="btn btn-primary mb-3" asp-action="Create">إنشاء رابط جديد</a>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>العنوان</th>
                        <th>الصورة</th>
                        <th>الرابط المختصر</th>
                        <th>النقرات</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var link in Model)
                    {
                        <tr>
                            <td>@link.Title</td>
                            <td>
                                <img src="@link.ImageUrl" alt="@link.Title" style="width: 50px; height: 50px; object-fit: cover;">
                            </td>
                            <td>
                                <a href="@Url.Action("Index", "Redirect", new { slug = link.Slug })" target="_blank">
                                    <code>@Url.Action("Index", "Redirect", new { slug = link.Slug })</code>
                                </a>
                                @* <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('@Url.Action("Index", "Redirect", new { slug = link.Slug })')">
                                    📋 نسخ
                                </button> *@
                                <button class="btn btn-sm btn-outline-secondary" onclick="copyToClipboard('@Url.Action("Index", "Redirect", new { slug = link.Slug }, Context.Request.Scheme)')" ">
                                    📋 نسخ
                                </button>
                            </td>
                            <td><span class="badge bg-info">@link.ClickCount</span></td>
                            <td>
                                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@link.Id">تعديل</a>
                                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@link.Id">حذف</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            لا توجد روابط حتى الآن. <a asp-action="Create">أنشئ رابطاً جديداً</a>
        </div>
    }
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(() => {
            alert('تم نسخ الرابط بنجاح!');
        });
    }
</script>
